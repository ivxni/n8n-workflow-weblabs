# ============================================
# Weblabs AI Lead Generator - Configuration
# ============================================
# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRES_PASSWORD=your_secure_password

# AI Provider (choose one)
# Option 1: OpenAI API (faster, paid)
# OPENAI_API_KEY=sk-...

# Option 2: Ollama runs locally in Docker (free, slower)
# No key needed

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your_app_password

# Sender Identity
SENDER_NAME=Your Name
SENDER_EMAIL=your-email@example.com
SENDER_PHONE=+49 123 456789
SENDER_COMPANY=YourCompany
SENDER_WEBSITE=https://your-website.com
WEBSITE_URL=https://your-website.com

# Google Places API (for business search)
# Create a key: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# Alternative: SerpAPI for Google Maps scraping
# SERPAPI_KEY=
